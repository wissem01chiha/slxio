#ifndef OPTIONS_H
#define OPTIONS_H

/* Build shared library */
#cmakedefine01 SLXIO_BUILD_SHARED

/* Enable ABI namespace */
#cmakedefine01 SLXIO_ABI_NAMESPACE

/* Enable 64-bit identifiers */
#cmakedefine01 SLXIO_64BIT_IDENTIFIERS

/* Project source directory */
#cmakedefine PROJECT_SOURCE_DIR "@PROJECT_SOURCE_DIR@"

/* Project Testing option */
#cmakedefine01 SLXIO_BUILD_TESTING 

#endif // OPTIONS_H