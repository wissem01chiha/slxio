#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------
DOXYFILE_ENCODING       = UTF-8
PROJECT_NAME            = @PROJECT_NAME@
PROJECT_NUMBER          = @TARGET_VERSION@
PROJECT_BRIEF           = 
PROJECT_LOGO            = 
PROJECT_ICON            = 
OUTPUT_DIRECTORY        = @DOXYGEN_OUTPUT_DIR@
OUTPUT_LANGUAGE         = English
MARKDOWN_SUPPORT        = YES
SHOW_NAMESPACES         = YES
SEARCHENGINE            = YES
RTF_HYPERLINKS          = YES
FULL_SIDEBAR            = YES
DISABLE_INDEX           = YES
GENERATE_TREEVIEW       = YES
HTML_COLORSTYLE         = 
HTML_EXTRA_STYLESHEET   = @DOXYGEN_EXTRA_STYLESHEET@
LAYOUT_FILE             = @DOXYGEN_LAYOUT_FILE@
HTML_HEADER            =  @DOXYGEN_HTML_HEADER@
HTML_FOOTER            =  @DOXYGEN_HTML_FOOTER@
HTML_STYLESHEET        =  @DOXYGEN_STYLESHEET@

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------
EXTRACT_ALL             = YES
RECURSIVE               = YES
GENERATE_HTML           = YES
GENERATE_LATEX          = NO

#---------------------------------------------------------------------------
# Configuration options related to the input files
#---------------------------------------------------------------------------
INPUT                  =  @DOXYGEN_INPUT@

INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.cxx \
                         *.cc \
                         *.cpp \
                         *.h \
                         *.hpp \
                         *.md \
                         *.txt \
                         *.dox 

#---------------------------------------------------------------------------
# configuration options for main page of the documentation
#---------------------------------------------------------------------------
#USE_MDFILE_AS_MAINPAGE = @MAINPAGE@
HAVE_DOT               = YES
DOT_NUM_THREADS        = 3
INTERACTIVE_SVG        = YES
DOT_IMAGE_FORMAT       = svg
DOT_GRAPH_MAX_NODES    = 100
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
HIDE_UNDOC_RELATIONS   = NO
TEMPLATE_RELATIONS     = YES
TOC_EXPAND             = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
GENERATE_LEGEND        = NO
GRAPHICAL_HIERARCHY    = YES        
MAX_DOT_GRAPH_DEPTH    = 100
USE_MATHJAX            = YES
GENERATE_BUGLIST       = YES
SHOW_INCLUDE_FILES     = YES
HTML_COPY_CLIPBOARD    = YES

