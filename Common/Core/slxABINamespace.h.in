#ifndef SLXABINAMESPACE_H
#define SLXABINAMESPACE_H

#cmakedefine01 ENABLE_NAMESPACE
#cmakedefine01 ENABLE_ABI_NAMESPACE

#if ENABLE_NAMESPACE
  #if defined(__cplusplus)
    #define SLXIO_NAMESPACE_BEGIN @NAMESPACE_BEGIN@
    #define SLXIO_NAMESPACE_END   @NAMESPACE_END@
  #else
    #define SLXIO_NAMESPACE_BEGIN  
    #define SLXIO_NAMESPACE_END   
  #endif
#else
    #define SLXIO_NAMESPACE_BEGIN
    #define SLXIO_NAMESPACE_END
#endif

#ifdef ENABLE_ABI_NAMESPACE
    #if defined(__cplusplus)
        #define SLXIO_ABI_NAMESPACE_BEGIN @ABI_NAMESPACE_BEGIN@
        #define SLXIO_ABI_NAMESPACE_END   @ABI_NAMESPACE_END@
    #else
        #define SLXIO_ABI_NAMESPACE_BEGIN
        #define SLXIO_ABI_NAMESPACE_END
    #endif
#else
    #define SLXIO_ABI_NAMESPACE_BEGIN
    #define SLXIO_ABI_NAMESPACE_END
#endif 

#endif // SLXABINAMESPACE_H